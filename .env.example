# DevSignal backend configuration. Copy to .env for local overrides —
# every value has a working development default.

# HTTP port the API listens on.
PORT=8080

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://devsignal:devsignal@localhost:5432/devsignal?sslmode=disable

# "development" or "production". Production turns on Secure cookies and HSTS.
APP_ENV=development

# Login session lifetime, in hours.
SESSION_TTL_HOURS=72

# bcrypt work factor (10–16). Higher is slower and stronger.
BCRYPT_COST=12

# Serve a built frontend from this directory (empty = API only; the Docker
# image sets it to /srv/static).
STATIC_DIR=
